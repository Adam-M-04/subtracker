{
  "name": "student/subtracker",
  "description": "SubTracker project with symbolic automated tests",
  "type": "project",
  "require": {},
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Core\\": "src/Core/",
      "Controllers\\": "src/Controllers/",
      "Entities\\": "src/Entities/",
      "Enums\\": "src/Enums/",
      "Repositories\\": "src/Repositories/",
      "Services\\": "src/Services/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  }
}

